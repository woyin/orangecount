{
  "name": "orangecount-visual-harness",
  "private": true,
  "description": "Development-only Playwright checks for the sanitized Fava fixture.",
  "engines": {
    "node": ">=22.18 <24"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:embedded": "ORANGECOUNT_SYNC_EMBEDDED=1 node build.mjs",
    "build:check": "node scripts/check-build.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "visual:test": "node scripts/run-visual.mjs",
    "visual:transplanted": "ORANGECOUNT_TRANSPLANTED_UI=1 node scripts/run-visual.mjs tests/visual/fava-transplanted.spec.mjs",
    "visual:reference": "node scripts/run-reference.mjs",
    "visual:update": "node scripts/run-visual.mjs --update-snapshots",
    "check:route-manifest": "node scripts/check-route-manifest.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:reference-output": "node scripts/check-reference-output.mjs",
    "check:phase0": "node scripts/check-route-manifest.mjs && node scripts/check-provenance.mjs"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "5.2.7",
    "@fontsource/fira-sans": "5.2.7",
    "@fontsource/source-code-pro": "5.2.7",
    "@playwright/test": "1.52.0",
    "esbuild": "0.27.0",
    "esbuild-svelte": "0.9.0",
    "svelte": "5.11.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "web-tree-sitter": "^0.26.11"
  }
}
