option "operating_currency" "USD"
2000-01-01 open Assets:Cash USD
2000-01-01 open Assets:Bank USD
2000-01-01 open Expenses:Food USD
2000-01-01 open Equity:Opening USD
2000-01-02 * "grocery" "split across accounts"
  Expenses:Food 40 USD
  Assets:Bank -30 USD
  Equity:Opening
2000-01-03 * "cash" "two legs with elided last"
  Assets:Cash 10 USD
  Equity:Opening -10 USD
2000-01-04 balance Assets:Cash 10 USD
2000-01-04 balance Assets:Bank -30 USD
