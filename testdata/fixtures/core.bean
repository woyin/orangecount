; Sanitized v3-core syntax corpus: no personal names, paths, or amounts.
option "operating_currency" "USD"
option "name_assets" "Assets"
2000-01-01 commodity USD
2000-01-01 open Assets:Cash USD
2000-01-01 open Assets:Shares SH
2000-01-01 open Equity:Opening USD
pushtag #fixture
2000-01-02 * "opening" #seed ^opening
  Assets:Cash 100 USD
  Equity:Opening -100 USD
  source: "sanitized"
poptag #fixture
2000-01-03 price SH 10 USD
2000-01-04 balance Assets:Cash 100 USD
2000-01-05 pad Assets:Cash Equity:Opening
2000-01-06 event "kind" "value"
2000-01-07 query "sample" "SELECT account FROM postings"
2000-01-08 document Assets:Cash "receipt.pdf" #fixture ^opening
2000-01-09 note Assets:Cash "sanitized note"
2000-01-10 custom "kind" "value" 1 USD
