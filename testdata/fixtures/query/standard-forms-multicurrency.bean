; Two-currency synthetic ledger used to pin PIVOT BY columns that have no row
; for a (row key, pivot value) combination. Expected values are the captured
; BeanQuery 0.2.0 observations for this input.
2000-01-01 open Assets:Cash USD, CNY
2000-01-01 open Equity:Opening USD, CNY
2000-01-01 open Expenses:Food USD, CNY
2000-01-02 * "opening usd"
  Assets:Cash 100.00 USD
  Equity:Opening -100.00 USD
2000-01-03 * "food usd"
  Expenses:Food 10.00 USD
  Assets:Cash -10.00 USD
2000-01-04 * "food cny"
  Expenses:Food 70.00 CNY
  Assets:Cash -70.00 CNY
