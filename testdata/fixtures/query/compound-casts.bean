include "compound-values.bean"
2000-01-07 open Assets:Precision STK "FIFO"
2000-01-08 * "precision acquisition"
  Assets:Precision 2.00 STK {10.00 USD, "a\"b"}
  Assets:Cash -20.0000 USD
2000-01-09 * "precision reduction"
  Assets:Precision -1.00 STK {} @ 12.00 USD
  Assets:Cash 12.00 USD
  Income:Gains
2000-01-10 open Assets:PreciseCost FND "FIFO"
2000-01-11 * "contextual cost"
  Assets:PreciseCost 1.2345678901234567890123456789 FND {1 USD}
  Assets:Cash -1.234567890123456789012345679 USD
2000-01-12 open Assets:Split STK "FIFO"
2000-01-13 * "split first"
  Assets:Split 2.0 STK {1.00 USD}
  Assets:Cash -2.00 USD
2000-01-14 * "split second"
  Assets:Split 2.00 STK {1.00 USD}
  Assets:Cash -2.0000 USD
2000-01-15 * "split sale"
  Assets:Split -3.00 STK {} @ 2.00 USD
  Assets:Cash 6.00 USD
  Income:Gains
2000-01-16 open Assets:Total STK "FIFO"
2000-01-17 * "total cost precision"
  Assets:Total 2 STK {{1.00 USD}}
  Assets:Cash -1.00 USD
