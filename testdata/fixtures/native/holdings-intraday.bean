option "operating_currency" "USD"
2000-01-01 open Assets:Cash USD
2000-01-01 open Assets:Stock STK "AVERAGE"
2000-01-01 open Income:Gains USD
2000-01-02 * "purchase"
  Assets:Stock 10 STK {10 USD}
  Assets:Cash -100 USD
2000-01-03 * "liquidation"
  Assets:Stock -10 STK {} @ 20 USD
  Assets:Cash 200 USD
  Income:Gains
2000-01-03 * "new position"
  Assets:Stock 5 STK {8 USD}
  Assets:Cash -40 USD
