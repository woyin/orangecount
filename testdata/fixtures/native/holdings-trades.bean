option "operating_currency" "USD"
2000-01-01 open Assets:Cash USD
2000-01-01 open Assets:Fifo STK "FIFO"
2000-01-01 open Assets:Lifo STK "LIFO"
2000-01-01 open Assets:Fees STK "FIFO"
2000-01-01 open Assets:Unassigned STK "FIFO"
2000-01-01 open Expenses:TradeFees USD
2000-01-01 open Income:Gains USD
2000-01-02 * "first lots"
  Assets:Fifo 2 STK {10 USD}
  Assets:Lifo 2 STK {10 USD}
  Assets:Cash -40 USD
2000-01-03 * "second lots"
  Assets:Fifo 3 STK {20 USD}
  Assets:Lifo 3 STK {20 USD}
  Assets:Cash -120 USD
2000-01-04 * "two total-price reductions"
  Assets:Fifo -4 STK {} @@ 100 USD
  Assets:Lifo -4 STK {} @@ 100 USD
  Assets:Cash 200 USD
  Income:Gains
2000-01-05 * "fee position"
  Assets:Fees 10 STK {10 USD}
  Assets:Cash -100 USD
2000-01-06 * "attributed fee"
  Assets:Fees -10 STK {} @ 20 USD
  Assets:Cash 195 USD
  Expenses:TradeFees 5 USD
    trade_fee_for: "Assets:Fees"
  Income:Gains
2000-01-07 * "unassigned fee position"
  Assets:Unassigned 10 STK {10 USD}
  Assets:Cash -100 USD
2000-01-08 * "unassigned fee"
  Assets:Unassigned -10 STK {} @ 20 USD
  Assets:Cash 195 USD
  Expenses:TradeFees 5 USD
  Income:Gains
