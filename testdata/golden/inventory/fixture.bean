;; Inventory probe fixture: one row for every standard table.
option "title" "Inventory probe"
option "operating_currency" "USD"
option "documents" "docs"
option "inferred_tolerance_default" "USD:0.005"

2020-01-01 open Assets:Cash USD,EUR
2020-01-01 open Assets:Broker HOOL
2020-01-01 open Expenses:Food
2020-01-01 open Income:Salary
2020-01-01 open Equity:Opening-Balances

2020-01-02 * "Cafe" "Lunch" #food ^receipt
  probe: "txn"
  Assets:Cash  -10.00 USD
    probe: "posting"
  Expenses:Food  10.00 USD

2020-01-03 ! "Broker" "Buy shares" #invest ^order
  Assets:Broker  2 HOOL {100.00 USD, 2020-01-03, "lot-a"}
  Assets:Cash  -200.00 USD

2020-01-04 * "Broker" "Sell shares"
  Assets:Broker  -1 HOOL {100.00 USD, 2020-01-03, "lot-a"} @ 120.00 USD
  Assets:Cash  120.00 USD
  Income:Salary  -20.00 USD

2020-01-05 balance Assets:Cash -90.00 ~ 0.005 USD
2020-01-06 note Assets:Cash "Checked" #cash ^note
2020-01-07 event "location" "Paris"
2020-01-08 commodity HOOL
2020-01-09 price HOOL 110.00 USD
2020-01-10 document Assets:Cash "docs/statement.pdf" #doc ^doc
2020-01-11 close Expenses:Food
